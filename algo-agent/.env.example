# Safety first: keep paper mode until strategy is proven on long backtests + paper-trading
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
DRY_RUN=true

# Monitor loop frequency in ms
POLL_MS=15000

# Comma-separated symbols. Use exchange-prefixed naming for clarity.
SYMBOLS=NSE:RELIANCE,NSE:TCS,NSE:HDFCBANK,NSE:INFY,NSE:ICICIBANK

# Capital and risk controls
INITIAL_CAPITAL=200000
RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS=3
COOLDOWN_MS=30000

# Strategy params
FAST_EMA_PERIOD=9
SLOW_EMA_PERIOD=21
STOP_LOSS_PCT=1.2
TAKE_PROFIT_PCT=2.4
TRAILING_STOP_PCT=0.8
